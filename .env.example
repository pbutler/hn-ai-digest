# Email provider for digest sending: resend or sendgrid
DIGEST_EMAIL_PROVIDER=resend

# Sender identity (must be valid for your provider/account)
DIGEST_FROM_EMAIL=HN Digest <onboarding@resend.dev>

# Required when DIGEST_EMAIL_PROVIDER=resend
RESEND_API_KEY=replace_me

# Required when DIGEST_EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=replace_me

# Required for semantic article ranking with OpenAI embeddings
OPENAI_API_KEY=replace_me
